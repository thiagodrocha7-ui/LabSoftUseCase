@model AppTask.Models.Incidentes


@{
    ViewData["Title"] = "Create";
}


<h1>Criar Incidente</h1>


<h4>Incidente</h4>
<hr />
<div class="row">
    <div class="col-md-6">
        <form action="/Incidentes/Create" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group mb-3">
                <label for="DescricaoProblema" class="control-label">Descrição do Problema</label>
                <textarea name="DescricaoProblema" id="DescricaoProblema" class="form-control"></textarea>
            </div>
            <div class="form-group mb-3">
                <label for="DataIncidente" class="control-label">Data do Incidente</label>
                <input type="datetime-local" name="DataIncidente" id="DataIncidente" class="form-control" />
            </div>
            <div class="form-group mb-3">
                <label for="Solucao" class="control-label">Solução</label>
                <textarea name="Solucao" id="Solucao" class="form-control"></textarea>
            </div>
            <div class="form-group mb-3 form-check">
                <input type="checkbox" name="Resolvido" id="Resolvido" class="form-check-input" value="true" />
                <input type="hidden" name="Resolvido" value="false" />
                <label class="form-check-label" for="Resolvido">Resolvido</label>
            </div>
            <div class="form-group mb-3">
                <input type="submit" value="Criar" class="btn btn-primary" />
                <a href="/Incidentes/Index" class="btn btn-secondary">Voltar</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}