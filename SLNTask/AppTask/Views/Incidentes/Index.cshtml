@model IEnumerable<AppTask.Models.Incidentes>


@{
    ViewData["Title"] = "Index";
}


<h1>Incidentes</h1>


<p>
    <a href="/Incidentes/Create" class="btn btn-success text-white">Novo</a>
</p>
<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.DescricaoProblema)</th>
            <th>@Html.DisplayNameFor(model => model.DataIncidente)</th>
            <th>@Html.DisplayNameFor(model => model.Solucao)</th>
            <th>@Html.DisplayNameFor(model => model.Resolvido)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.DescricaoProblema)</td>
                <td>@Html.DisplayFor(modelItem => item.DataIncidente)</td>
                <td>@Html.DisplayFor(modelItem => item.Solucao)</td>
                <td>@Html.DisplayFor(modelItem => item.Resolvido)</td>
                <td>
                    <a href="/Incidentes/Edit/@item.Codigo" class="btn btn-primary btn-sm">Editar</a>
                    <a href="/Incidentes/Details/@item.Codigo" class="btn btn-success btn-sm text-white">Detalhes</a>
                    <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@item.Codigo" data-descricao="@item.DescricaoProblema">
                        Excluir
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>


<!-- Modal de Exclusão -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirmar Exclusão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Tem certeza que deseja excluir o incidente <strong id="itemDescricao"></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Excluir</button>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        var deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var id = button.getAttribute('data-id');
            var descricao = button.getAttribute('data-descricao');


            var modalBodyStrong = deleteModal.querySelector('#itemDescricao');
            var deleteForm = deleteModal.querySelector('#deleteForm');


            modalBodyStrong.textContent = descricao;
            deleteForm.action = '/Incidentes/Delete/' + id;
        });
    </script>
}