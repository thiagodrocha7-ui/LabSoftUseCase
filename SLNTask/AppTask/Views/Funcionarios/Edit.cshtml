@model AppTask.Models.Funcionario


@{
    ViewData["Title"] = "Editar Funcionário";
}


<h1 class="mb-4">Editar Funcionário</h1>


<div class="row">
    <div class="col-md-6">
        <form action="/Funcionarios/Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Codigo" value="@Model.Codigo" />


            <div class="mb-3">
                <label for="Nome" class="form-label font-weight-bold">Nome</label>
                <input type="text" id="Nome" name="Nome" class="form-control" value="@Model.Nome" required />
            </div>


            <div class="mb-3">
                <label for="Cargo" class="form-label">Cargo</label>
                <input type="text" id="Cargo" name="Cargo" class="form-control" value="@Model.Cargo" required />
            </div>


            <div class="mb-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Atualizar Funcionário</button>
                <a href="/Funcionarios/Index" class="btn btn-secondary">Voltar para a Lista</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}