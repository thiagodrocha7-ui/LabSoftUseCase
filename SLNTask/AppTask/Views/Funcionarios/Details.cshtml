@model AppTask.Models.Funcionario


@{
    ViewData["Title"] = "Detalhes do Funcionário";
}


<h1 class="mb-4">Detalhes do Funcionário</h1>


<div>
    <dl class="row">
        <dt class="col-sm-3">Nome</dt>
        <dd class="col-sm-9">@Model.Nome</dd>


        <dt class="col-sm-3">Cargo</dt>
        <dd class="col-sm-9">@Model.Cargo</dd>
    </dl>
</div>
<div class="d-flex gap-2">
    <a href="/Funcionarios/Edit/@Model.Codigo" class="btn btn-primary">Alterar</a>
    <a href="/Funcionarios/Index" class="btn btn-secondary">Voltar para a Lista</a>
</div>