@model AppTask.Models.Funcionario


@{
    ViewData["Title"] = "Excluir Funcionário";
}


<h1 class="mb-4 text-danger">Excluir Funcionário</h1>
<h4 class="mb-3">Tem certeza de que deseja excluir este funcionário?</h4>


<div>
    <dl class="row">
        <dt class="col-sm-3">Nome</dt>
        <dd class="col-sm-9">@Model.Nome</dd>


        <dt class="col-sm-3">Cargo</dt>
        <dd class="col-sm-9">@Model.Cargo</dd>
    </dl>


    <form action="/Funcionarios/Delete/@Model.Codigo" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Codigo" value="@Model.Codigo" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Sim, Excluir</button>
            <a href="/Funcionarios/Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>